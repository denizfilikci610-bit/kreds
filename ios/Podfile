# VibeFeed iOS — no third-party pods.
#
# VibeFeed shows no ads and does not track users. The binary must not link any
# advertising framework, and must not reference AppTrackingTransparency.

platform :ios, '17.0'

source 'https://cdn.cocoapods.org/'

install! 'cocoapods', :deterministic_uuids => false

use_frameworks!

target 'VibeFeed' do
  # No pods. Intentionally empty.
end

# Keep the (empty) pods project on iOS 17 and quiet simulator signing.
post_install do |installer|
  installer.pods_project.targets.each do |target|
    target.build_configurations.each do |config|
      config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '17.0'
      config.build_settings['CODE_SIGNING_ALLOWED'] = 'NO'
    end
  end
end
