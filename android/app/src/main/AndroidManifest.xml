<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      INTERNET er den eneste tilladelse appen har brug for.

      Kamera og fotobibliotek klares BEVIDST uden tilladelser: billeder hentes gennem
      systemets egen fotovælger, og kameraet åbnes med ACTION_IMAGE_CAPTURE, som en
      fremmed app (kamera-appen) udfører for os. Erklærer man CAMERA i manifestet,
      begynder Android at kræve den tilladelse også for den intent, så erklæringen
      ville gøre det værre, ikke bedre.
    -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Notifikationer kræver siden Android 13 en runtime-tilladelse. Der spørges når
         web melder login (creds), samme øjeblik som iOS spørger. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!--
      Den native medie-komposer har sit eget kamera og sit eget galleri-gitter, som på iOS,
      og dét kræver de tilladelser systemets fotovælger ellers slap for. Begge spørges der
      om FØRST når brugeren åbner komposeren, aldrig ved opstart, og siger man nej, overtager
      web sin egen filvælger i stedet.
    -->
    <uses-permission android:name="android.permission.CAMERA" />
    <!-- Uden denne er kamera-videoer LYDLØSE. iPhone-appen optager med lyd. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission android:name="android.permission.READ_MEDIA_VIDEO" />
    <!-- Android 14's "udvalgte billeder": beder man om den uden at deklarere den,
         afvises den tavst, og et delvist valg lignede et blankt nej. -->
    <uses-permission android:name="android.permission.READ_MEDIA_VISUAL_USER_SELECTED" />
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />

    <!-- Kameraet er valgfrit: appen virker fint på enheder uden -->
    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <!-- allowBackup=false: login-sessionen bor i WebView'ets localStorage, og reglerne i
         backup_rules kan ikke udelukke WebView-mapperne pålideligt. En session må aldrig
         følge med i cloud-backup eller enhedsoverførsel, samme holdning som på iPhone. -->
    <application
        android:allowBackup="false"
        android:fullBackupContent="@xml/backup_rules"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:usesCleartextTraffic="false"
        android:theme="@style/Theme.VibeFeed">

        <!-- screenOrientation: iPhone-appen er portræt-låst, og hele fladen (kamera-rammen,
             zoom.js' layout-bredde, de native barer) er bygget til det. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboard|keyboardHidden|navigation|uiMode|density|fontScale|locale|layoutDirection">

            <!-- Android 16 ignorerer portræt-låsen på skærme over 600 dp uden denne
                 opt-out. Hele fladen (kamera-rammen, zoom.js, barerne) er portræt. -->
            <property
                android:name="android.window.PROPERTY_COMPAT_ALLOW_RESTRICTED_RESIZABILITY"
                android:value="true" />

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!--
              App Links: bekræftelses- og nulstillingsmails peger på vibefeed.dk, og med
              en verificeret .well-known/assetlinks.json på sitet åbner de i appen i
              stedet for i Chrome. Filen kan først laves når Play har genereret app-
              signeringsnøglen, så indtil da fejler verifikationen stille og linkene
              åbner i browseren, hvor de virker præcis som før.
            -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="vibefeed.dk" />
                <data android:scheme="https" android:host="www.vibefeed.dk" />
            </intent-filter>
        </activity>

        <!-- FCM-beskeder. Serveren sender rent data, tjenesten tegner selv notifikationen
             og lægger deep-link-payloaden i tap-intenten. -->
        <service
            android:name=".notif.VfMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

        <!-- Midlertidig fil til kamera-optagelser, saa kamera-appen kan skrive resultatet -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

    <!-- Android 11+ kraever at vi erklaerer hvilke fremmede apps vi vil kunne kalde -->
    <queries>
        <intent>
            <action android:name="android.media.action.IMAGE_CAPTURE" />
        </intent>
        <intent>
            <action android:name="android.media.action.VIDEO_CAPTURE" />
        </intent>
        <intent>
            <action android:name="android.provider.action.PICK_IMAGES" />
        </intent>
        <intent>
            <action android:name="android.intent.action.GET_CONTENT" />
            <data android:mimeType="*/*" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="https" />
        </intent>
        <intent>
            <action android:name="android.intent.action.SENDTO" />
            <data android:scheme="mailto" />
        </intent>
    </queries>
</manifest>
